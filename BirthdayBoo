<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday, Alex! 🎉</title>

<!--
  ══════════════════════════════════════════════════════════════
  HOW TO CUSTOMIZE THIS PAGE
  1. Search for "Alex" (Ctrl/Cmd+F) and replace with your person's name.
  2. Scroll to the "MEMORIES" section and swap the <img src="...."> links
     for your own photos (and update the captions).
  3. Edit the wish paragraphs in the "WISHES" section to say what you
     really want to say.
  4. Edit the messages hidden inside the gift boxes in "SURPRISES".
  5. Edit the four facts in "THE HIGHLIGHT REEL".
  Everything else (animations, confetti, sounds) will just work.
  ══════════════════════════════════════════════════════════════
-->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">

<style>
  /* ============================= TOKENS ============================= */
  :root{
    --bg-1:#241736;
    --bg-2:#34204e;
    --bg-3:#1a1128;
    --pink:#ff4d8d;
    --pink-dark:#e63e7a;
    --gold:#ffc94d;
    --gold-dark:#e6ac1f;
    --turquoise:#35dfc0;
    --turquoise-dark:#1fb89b;
    --tangerine:#ff7a45;
    --tangerine-dark:#e85e2a;
    --violet:#8c6fe6;
    --cream:#fff6ea;
    --ink:#1c1230;
    --shadow:rgba(20,10,35,.45);
    --radius-lg:28px;
    --radius-md:18px;
    --radius-sm:10px;
    --font-display:'Baloo 2', system-ui, sans-serif;
    --font-body:'Nunito', system-ui, sans-serif;
  }

  *{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; }

  body{
    margin:0;
    background:
      radial-gradient(1200px 700px at 15% -10%, #3c2657 0%, transparent 60%),
      radial-gradient(1000px 600px at 90% 10%, #452a63 0%, transparent 55%),
      linear-gradient(180deg, var(--bg-1) 0%, var(--bg-2) 45%, var(--bg-3) 100%);
    background-attachment:fixed;
    color:var(--cream);
    font-family:var(--font-body);
    font-size:17px;
    line-height:1.6;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }

  h1,h2,h3{ font-family:var(--font-display); margin:0; }
  p{ margin:0; }
  img{ max-width:100%; display:block; }
  button{ font-family:inherit; cursor:pointer; }

  a{ color:var(--gold); }

  :focus-visible{
    outline:3px solid var(--gold);
    outline-offset:3px;
    border-radius:6px;
  }

  .sr-only{
    position:absolute; width:1px; height:1px; padding:0; margin:-1px;
    overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;
  }

  /* Ambient confetti canvas — sits behind everything */
  #confetti-canvas{
    position:fixed; inset:0; width:100%; height:100%;
    pointer-events:none; z-index:0;
  }

  .wrap{
    position:relative;
    z-index:1;
    max-width:1080px;
    margin:0 auto;
    padding:0 24px;
  }

  section{ position:relative; padding:110px 0; }
  section.tight{ padding:70px 0; }

  .eyebrow{
    display:inline-block;
    font-family:var(--font-body);
    font-weight:800;
    letter-spacing:.14em;
    text-transform:uppercase;
    font-size:13px;
    color:var(--gold);
    margin-bottom:14px;
  }

  .section-title{
    font-size:clamp(30px, 4.5vw, 46px);
    font-weight:700;
    color:var(--cream);
    max-width:640px;
  }

  .section-sub{
    margin-top:14px;
    max-width:560px;
    color:#e5d9f5;
    font-size:17px;
  }

  /* ---- fixed controls ---- */
  .controls{
    position:fixed;
    top:18px;
    right:18px;
    z-index:50;
    display:flex;
    gap:10px;
  }
  .icon-btn{
    width:46px; height:46px;
    border-radius:50%;
    border:1px solid rgba(255,255,255,.25);
    background:rgba(28,18,48,.55);
    backdrop-filter:blur(8px);
    color:var(--cream);
    font-size:20px;
    display:flex; align-items:center; justify-content:center;
    transition:transform .25s ease, background .25s ease;
  }
  .icon-btn:hover{ transform:translateY(-3px) scale(1.06); background:rgba(255,77,141,.35); }
  .icon-btn:active{ transform:translateY(0) scale(.96); }

  /* ============================= REVEAL ============================= */
  .reveal{
    opacity:0;
    transform:translateY(36px);
    transition:opacity .8s cubic-bezier(.2,.7,.3,1), transform .8s cubic-bezier(.2,.7,.3,1);
  }
  .reveal.in-view{ opacity:1; transform:none; }

  /* ============================= HERO ============================= */
  .hero{
    min-height:100svh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:140px 24px 80px;
    overflow:hidden;
  }

  .hero-inner{ position:relative; z-index:2; max-width:760px; }

  .hero .eyebrow{
    background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.18);
    padding:6px 16px;
    border-radius:100px;
    color:var(--turquoise);
  }

  .hero h1{
    font-size:clamp(44px, 9vw, 92px);
    font-weight:800;
    line-height:1.04;
    color:var(--cream);
    text-shadow:0 10px 40px rgba(255,77,141,.35);
  }
  .hero h1 .word{
    display:inline-block;
    opacity:0;
    transform:translateY(28px) rotate(-2deg);
    animation:word-in .7s cubic-bezier(.2,.8,.3,1) forwards;
  }
  .hero h1 .highlight{ color:var(--gold); }
  @keyframes word-in{ to{ opacity:1; transform:translateY(0) rotate(0);} }

  .hero p.tagline{
    margin-top:22px;
    font-size:clamp(17px,2.2vw,21px);
    color:#e9def7;
    max-width:520px;
    margin-left:auto; margin-right:auto;
    opacity:0;
    animation:fade-up .8s ease .9s forwards;
  }
  @keyframes fade-up{ from{opacity:0; transform:translateY(16px);} to{opacity:1; transform:translateY(0);} }

  .floatie{ position:absolute; z-index:1; will-change:transform; transition:transform .15s ease-out; }
  .balloon{
    width:52px; height:66px;
    border-radius:50% 50% 50% 50% / 58% 58% 42% 42%;
    position:relative;
    animation:bob 4.5s ease-in-out infinite;
    box-shadow:inset -8px -8px 16px rgba(0,0,0,.18), inset 6px 8px 14px rgba(255,255,255,.25);
  }
  .balloon::after{
    content:'';
    position:absolute; left:50%; bottom:-56px;
    width:1px; height:56px;
    background:rgba(255,255,255,.28);
    transform:translateX(-50%);
  }
  .balloon::before{
    content:'';
    position:absolute; left:50%; bottom:-6px;
    width:6px; height:6px;
    background:inherit;
    transform:translateX(-50%) rotate(45deg);
  }
  .balloon.pink{ background:var(--pink); }
  .balloon.gold{ background:var(--gold); }
  .balloon.turq{ background:var(--turquoise); }
  .balloon.tang{ background:var(--tangerine); }
  @keyframes bob{ 0%,100%{ transform:translateY(0) rotate(-3deg);} 50%{ transform:translateY(-22px) rotate(3deg);} }

  .scroll-cue{
    margin-top:64px;
    display:flex; flex-direction:column; align-items:center; gap:8px;
    color:#cdbdea; font-size:13px; letter-spacing:.08em; text-transform:uppercase;
    background:none; border:none; opacity:0; animation:fade-up .8s ease 1.3s forwards;
  }
  .scroll-cue .chev{ animation:chev-bounce 1.8s ease-in-out infinite; font-size:18px; }
  @keyframes chev-bounce{ 0%,100%{ transform:translateY(0);} 50%{ transform:translateY(8px);} }

  /* ============================= CAKE ============================= */
  .cake-stage{
    margin-top:56px;
    display:flex; flex-direction:column; align-items:center;
    opacity:0; animation:fade-up .9s ease 1.1s forwards;
  }

  .cake{ position:relative; padding-top:70px; }

  .candles{
    position:absolute; top:0; left:50%; transform:translateX(-50%);
    display:flex; gap:16px; z-index:5;
  }
  .candle{
    background:none; border:none; padding:0;
    width:10px; display:flex; flex-direction:column; align-items:center;
    position:relative;
  }
  .candle .flame{
    width:12px; height:18px;
    border-radius:50% 50% 50% 50% / 65% 65% 35% 35%;
    background:radial-gradient(circle at 50% 70%, #fff6c8 0%, var(--gold) 55%, var(--tangerine) 100%);
    box-shadow:0 0 14px 4px rgba(255,201,77,.7);
    animation:flicker 1.6s ease-in-out infinite;
    transform-origin:bottom center;
    transition:opacity .3s ease, transform .3s ease;
  }
  .candle .stick{
    width:8px; height:34px; margin-top:2px;
    background:repeating-linear-gradient(180deg, var(--pink) 0 6px, var(--cream) 6px 12px);
    border-radius:2px;
  }
  @keyframes flicker{
    0%,100%{ transform:scale(1,1) rotate(0deg); }
    30%{ transform:scale(.92,1.05) rotate(-3deg); }
    60%{ transform:scale(1.05,.94) rotate(3deg); }
  }
  .candle.out .flame{ opacity:0; transform:scale(.3); }
  .candle.out .smoke{
    position:absolute; top:-4px; left:50%;
    width:5px; height:5px; border-radius:50%;
    background:rgba(255,255,255,.55);
    animation:smoke-rise 1.1s ease-out forwards;
  }
  @keyframes smoke-rise{
    0%{ opacity:.8; transform:translate(-50%,0) scale(1); }
    100%{ opacity:0; transform:translate(-50%,-40px) scale(2.4); }
  }
  .candle:not(.out):hover .flame{ box-shadow:0 0 22px 8px rgba(255,201,77,.9); }

  .tier{ position:relative; margin:0 auto; z-index:2; }
  .tier-top{
    width:150px; height:64px;
    background:linear-gradient(180deg, var(--pink) 0%, var(--pink-dark) 100%);
    border-radius:10px 10px 4px 4px;
  }
  .tier-bottom{
    width:220px; height:88px;
    margin-top:-4px;
    background:linear-gradient(180deg, var(--tangerine) 0%, var(--tangerine-dark) 100%);
    border-radius:10px 10px 4px 4px;
  }
  .frosting{
    position:absolute; top:-11px; left:0; right:0;
    display:flex; justify-content:space-between; padding:0 4px;
  }
  .frosting span{
    width:18px; height:18px; border-radius:50%;
    background:var(--cream);
    box-shadow:0 3px 4px rgba(0,0,0,.15);
  }
  .plate{
    width:250px; height:16px; margin:0 auto;
    background:linear-gradient(180deg, var(--cream), #f0e4d0);
    border-radius:50%;
    box-shadow:0 10px 24px var(--shadow);
  }

  .cake-hint{
    margin-top:26px; font-weight:700; color:#e9def7; font-size:15px;
    transition:opacity .4s ease;
  }
  .wish-revealed{
    margin-top:18px; font-family:var(--font-display); font-size:22px; color:var(--gold);
    opacity:0; transform:translateY(10px);
    transition:opacity .6s ease, transform .6s ease;
  }
  .wish-revealed.show{ opacity:1; transform:translateY(0); }

  /* ============================= WISHES ============================= */
  .wish-grid{
    margin-top:52px;
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:28px;
  }
  .wish-card{
    background:linear-gradient(180deg, #fff9ef 0%, #fff2dc 100%);
    color:var(--ink);
    border-radius:6px;
    padding:30px 26px 26px;
    box-shadow:0 18px 40px var(--shadow);
    transition:transform .12s ease-out, box-shadow .3s ease;
    will-change:transform;
    position:relative;
  }
  .wish-card:nth-child(1){ transform:rotate(-2deg); }
  .wish-card:nth-child(2){ transform:rotate(1.5deg); }
  .wish-card:nth-child(3){ transform:rotate(-1deg); }
  .wish-card::before{
    content:'';
    position:absolute; top:-10px; left:50%; transform:translateX(-50%);
    width:26px; height:14px;
    background:rgba(255,255,255,.55);
    border:1px solid rgba(255,255,255,.7);
  }
  .wish-card:hover{ box-shadow:0 26px 54px var(--shadow); }
  .wish-card .label{
    display:inline-block; font-weight:800; font-size:12px; letter-spacing:.1em;
    text-transform:uppercase; color:var(--pink-dark); margin-bottom:12px;
  }
  .wish-card p{ font-size:16px; line-height:1.65; color:#3a2b52; }
  .wish-card .sign{ display:block; margin-top:16px; font-family:var(--font-display); font-size:15px; color:var(--tangerine-dark); }

  /* ============================= HIGHLIGHTS (flip cards) ============================= */
  .flip-grid{
    margin-top:48px;
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:20px;
  }
  .flip-card{
    perspective:1000px;
    height:190px;
  }
  .flip-card button{
    all:unset;
    display:block;
    width:100%; height:100%;
    position:relative;
    transform-style:preserve-3d;
    transition:transform .6s cubic-bezier(.2,.8,.2,1);
    border-radius:var(--radius-md);
  }
  .flip-card.flipped button{ transform:rotateY(180deg); }
  .flip-face{
    position:absolute; inset:0;
    border-radius:var(--radius-md);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; padding:18px;
    backface-visibility:hidden;
    -webkit-backface-visibility:hidden;
  }
  .flip-front{
    background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.16);
  }
  .flip-front .emoji{ font-size:34px; margin-bottom:10px; }
  .flip-front .flabel{ font-family:var(--font-display); font-weight:700; font-size:17px; color:var(--turquoise); }
  .flip-front .tap{ margin-top:10px; font-size:12px; color:#c9bce3; }
  .flip-back{
    background:linear-gradient(160deg, var(--violet), #6a4fc7);
    transform:rotateY(180deg);
    font-size:14.5px;
    line-height:1.55;
    color:var(--cream);
    font-weight:600;
  }
  .flip-card button:hover .flip-front{ border-color:var(--turquoise); }

  /* ============================= MEMORIES / GALLERY ============================= */
  .garland{
    position:relative;
    margin-top:56px;
    display:grid;
    grid-template-columns:repeat(5, 1fr);
    gap:22px;
  }
  .polaroid{
    background:#fff;
    padding:10px 10px 34px;
    border-radius:3px;
    box-shadow:0 14px 30px var(--shadow);
    cursor:pointer;
    transition:transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease;
    position:relative;
  }
  .polaroid:nth-child(odd){ transform:rotate(-3deg) translateY(6px); }
  .polaroid:nth-child(even){ transform:rotate(2.5deg) translateY(-8px); }
  .polaroid:hover{ transform:scale(1.06) rotate(0deg) translateY(-6px); box-shadow:0 24px 46px var(--shadow); z-index:3; }
  .polaroid img{ width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:2px; }
  .polaroid .caption{
    position:absolute; bottom:8px; left:0; right:0; text-align:center;
    font-family:var(--font-display); font-size:13px; color:var(--ink);
  }
  .polaroid .pin{
    position:absolute; top:-9px; left:50%; transform:translateX(-50%);
    width:14px; height:14px; border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #fff, var(--pink) 60%);
    box-shadow:0 3px 4px rgba(0,0,0,.35);
  }

  /* Lightbox */
  .lightbox{
    position:fixed; inset:0; z-index:100;
    display:flex; align-items:center; justify-content:center;
    padding:24px;
    opacity:0; pointer-events:none;
    transition:opacity .3s ease;
  }
  .lightbox.open{ opacity:1; pointer-events:auto; }
  .lightbox-backdrop{
    position:absolute; inset:0;
    background:rgba(10,6,20,.82);
    backdrop-filter:blur(6px);
  }
  .lightbox-content{
    position:relative; z-index:2;
    background:#fff; padding:16px 16px 40px;
    border-radius:6px; max-width:min(520px, 90vw);
    transform:scale(.9); transition:transform .3s cubic-bezier(.2,.8,.2,1);
  }
  .lightbox.open .lightbox-content{ transform:scale(1); }
  .lightbox-content img{ border-radius:2px; width:100%; }
  .lightbox-caption{
    margin-top:14px; text-align:center; font-family:var(--font-display);
    font-size:18px; color:var(--ink);
  }
  .lightbox-close{
    position:absolute; top:-16px; right:-16px;
    width:38px; height:38px; border-radius:50%;
    background:var(--pink); color:#fff; border:3px solid var(--bg-2);
    font-size:18px; display:flex; align-items:center; justify-content:center;
  }
  .lightbox-close:hover{ background:var(--pink-dark); }

  /* ============================= SURPRISES / GIFT BOXES ============================= */
  .gift-row{
    margin-top:56px;
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:30px;
  }
  .gift{
    background:none; border:none; color:inherit;
    display:flex; flex-direction:column; align-items:center; gap:16px;
    padding:10px;
  }
  .gift-box{
    width:120px; height:100px;
    position:relative;
    transition:transform .25s ease;
  }
  .gift:hover .gift-box{ transform:translateY(-6px) rotate(-2deg); }
  .gift-base{
    position:absolute; bottom:0; left:0; right:0; height:74px;
    border-radius:8px;
    box-shadow:0 16px 30px var(--shadow);
  }
  .gift-ribbon-v{
    position:absolute; bottom:0; left:50%; transform:translateX(-50%);
    width:16px; height:74px; background:var(--cream); opacity:.9;
  }
  .gift-lid{
    position:absolute; top:14px; left:-6px; right:-6px; height:26px;
    border-radius:8px;
    box-shadow:0 6px 14px var(--shadow);
    transition:transform .5s cubic-bezier(.3,1.4,.4,1), opacity .5s ease;
    transform-origin:left center;
  }
  .gift-lid::after{
    content:'';
    position:absolute; top:-14px; left:50%; transform:translateX(-50%);
    width:22px; height:22px; border-radius:50% 50% 50% 0;
    background:inherit;
  }
  .gift.opened .gift-lid{ transform:translateY(-46px) rotate(-35deg); opacity:0; }
  .gift-pink .gift-base, .gift-pink .gift-lid{ background:linear-gradient(180deg, var(--pink), var(--pink-dark)); }
  .gift-turq .gift-base, .gift-turq .gift-lid{ background:linear-gradient(180deg, var(--turquoise), var(--turquoise-dark)); }
  .gift-gold .gift-base, .gift-gold .gift-lid{ background:linear-gradient(180deg, var(--gold), var(--gold-dark)); }

  .gift-msg{
    max-width:220px; text-align:center; font-size:14.5px; color:#e9def7;
    min-height:22px;
  }
  .gift-hint{ font-weight:700; font-size:13px; color:var(--gold); letter-spacing:.03em; }
  .gift.opened .gift-hint{ display:none; }

  /* ============================= FOOTER / FINALE ============================= */
  .finale{
    text-align:center;
    padding:120px 24px 100px;
  }
  .finale .section-title{ margin:0 auto 18px; }
  .finale .section-sub{ margin-left:auto; margin-right:auto; }
  .finale-btn{
    margin-top:38px;
    border:none;
    background:linear-gradient(135deg, var(--pink), var(--tangerine));
    color:#fff;
    font-family:var(--font-display);
    font-weight:700;
    font-size:19px;
    padding:18px 40px;
    border-radius:100px;
    box-shadow:0 18px 40px rgba(255,77,141,.4);
    transition:transform .2s ease, box-shadow .2s ease;
  }
  .finale-btn:hover{ transform:translateY(-4px) scale(1.03); box-shadow:0 24px 50px rgba(255,77,141,.55); }
  .finale-btn:active{ transform:translateY(0) scale(.98); }

  .signature{
    margin-top:60px;
    font-family:var(--font-display);
    color:#c9bce3;
    font-size:15px;
  }

  .floating-heart{
    position:fixed; bottom:-40px; z-index:60;
    font-size:22px; pointer-events:none;
    animation:heart-rise linear forwards;
  }
  @keyframes heart-rise{
    0%{ transform:translateY(0) translateX(0) rotate(0deg); opacity:1; }
    100%{ transform:translateY(-110vh) translateX(20px) rotate(25deg); opacity:0; }
  }

  .toast{
    position:fixed; left:50%; bottom:32px; transform:translate(-50%, 20px);
    background:var(--cream); color:var(--ink);
    font-weight:700; font-size:14.5px;
    padding:14px 22px; border-radius:100px;
    box-shadow:0 14px 30px var(--shadow);
    z-index:80; opacity:0; transition:opacity .35s ease, transform .35s ease;
    pointer-events:none;
  }
  .toast.show{ opacity:1; transform:translate(-50%, 0); }

  /* ============================= RESPONSIVE ============================= */
  @media (max-width:880px){
    .wish-grid{ grid-template-columns:1fr; }
    .flip-grid{ grid-template-columns:repeat(2, 1fr); }
    .garland{ grid-template-columns:repeat(2, 1fr); }
    .gift-row{ grid-template-columns:1fr; gap:44px; }
    section{ padding:80px 0; }
    .floatie{ display:none; }
  }
  @media (max-width:480px){
    .flip-card{ height:170px; }
  }

  @media (prefers-reduced-motion: reduce){
    *, *::before, *::after{
      animation-duration:.01ms !important;
      animation-iteration-count:1 !important;
      transition-duration:.01ms !important;
      scroll-behavior:auto !important;
    }
  }
</style>
</head>
<body>

<canvas id="confetti-canvas" aria-hidden="true"></canvas>

<div class="controls">
  <button class="icon-btn" id="confettiBtn" aria-label="Trigger confetti burst" title="Confetti!">🎉</button>
  <button class="icon-btn" id="muteBtn" aria-label="Mute sound" title="Toggle sound">🔊</button>
</div>

<!-- ============================= HERO ============================= -->
