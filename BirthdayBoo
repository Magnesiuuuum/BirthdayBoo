<script>
(function(){
  "use strict";

  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------------------------------------------------------------
     Ambient + burst confetti (canvas based, no external libraries)
  --------------------------------------------------------------- */
  var canvas = document.getElementById('confetti-canvas');
  var ctx = canvas.getContext('2d');
  var W, H;
  function resize(){ W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
  window.addEventListener('resize', resize);
  resize();

  var COLORS = ['#ff4d8d', '#ffc94d', '#35dfc0', '#ff7a45', '#8c6fe6'];
  var particles = [];

  function spawnParticle(x, y, burst){
    particles.push({
      x: x, y: y,
      vx: burst ? (Math.random() - 0.5) * 9 : (Math.random() - 0.5) * 0.6,
      vy: burst ? (Math.random() * -8 - 2) : (Math.random() * 0.8 + 0.4),
      size: Math.random() * 6 + 5,
      color: COLORS[Math.floor(Math.random() * COLORS.length)],
      rot: Math.random() * 360,
      rotSpeed: (Math.random() - 0.5) * 10,
      shape: Math.random() > 0.5 ? 'rect' : 'circle',
      gravity: burst ? 0.32 : 0.05,
      drag: burst ? 0.985 : 1,
      life: 0
    });
  }

  function burstConfetti(x, y, count){
    count = count || 60;
    for (var i = 0; i < count; i++) spawnParticle(x, y, true);
  }

  var ambientTimer = null;
  if (!reduceMotion){
    ambientTimer = setInterval(function(){
      if (particles.length < 110) spawnParticle(Math.random() * W, -12, false);
    }, 260);
  }

  function tick(){
    ctx.clearRect(0, 0, W, H);
    for (var i = particles.length - 1; i >= 0; i--){
      var p = particles[i];
      p.vy += p.gravity * 0.06;
      p.vx *= p.drag; p.vy *= p.drag;
      p.x += p.vx; p.y += p.vy;
      p.rot += p.rotSpeed;
      p.life++;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot * Math.PI / 180);
      ctx.fillStyle = p.color;
      if (p.shape === 'rect'){
        ctx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
      } else {
        ctx.beginPath();
        ctx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
      if (p.y > H + 30 || p.life > 700) particles.splice(i, 1);
    }
    requestAnimationFrame(tick);
  }
  tick();

  document.getElementById('confettiBtn').addEventListener('click', function(){
    burstConfetti(window.innerWidth / 2, window.innerHeight * 0.3, 90);
    playChime(494);
  });

  /* ---------------------------------------------------------------
     Soft chime sounds (Web Audio API — no external audio files)
  --------------------------------------------------------------- */
  var audioCtx = null;
  var muted = false;
  var muteBtn = document.getElementById('muteBtn');

  function playChime(freq){
    if (muted) return;
    try{
      audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
      var osc = audioCtx.createOscillator();
      var gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.value = freq || 440;
      gain.gain.setValueAtTime(0.0001, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.16, audioCtx.currentTime + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.5);
      osc.connect(gain).connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.5);
    } catch(e) { /* audio unsupported — fail silently */ }
  }

  muteBtn.addEventListener('click', function(){
    muted = !muted;
    muteBtn.textContent = muted ? '🔇' : '🔊';
    muteBtn.setAttribute('aria-label', muted ? 'Unmute sound' : 'Mute sound');
  });

  /* ---------------------------------------------------------------
     Hero headline: staggered word entrance
  --------------------------------------------------------------- */
  var heroTitle = document.getElementById('heroTitle');
  (function staggerWords(){
    var html = heroTitle.innerHTML;
    var container = document.createElement('div');
    container.innerHTML = html;
    var out = [];
    var delay = 0;
    container.childNodes.forEach(function(node){
      if (node.nodeType === Node.TEXT_NODE){
        node.textContent.split(' ').filter(Boolean).forEach(function(word){
          out.push('<span class="word" style="animation-delay:' + delay + 's">' + word + '&nbsp;</span>');
          delay += 0.09;
        });
      } else {
        out.push('<span class="word" style="animation-delay:' + delay + 's">' + node.outerHTML + '</span>');
        delay += 0.09;
      }
    });
    heroTitle.innerHTML = out.join('');
  })();

  /* ---------------------------------------------------------------
     Floating balloon parallax
  --------------------------------------------------------------- */
  if (!reduceMotion){
    document.addEventListener('mousemove', function(e){
      var x = (e.clientX / window.innerWidth) - 0.5;
      var y = (e.clientY / window.innerHeight) - 0.5;
      document.querySelectorAll('.floatie').forEach(function(el){
        var depth = parseFloat(el.dataset.depth) || 1;
        el.style.transform = 'translate(' + (x * depth * 26) + 'px,' + (y * depth * 26) + 'px)';
      });
    });
  }

  /* ---------------------------------------------------------------
     Scroll cue
  --------------------------------------------------------------- */
  document.getElementById('scrollCue').addEventListener('click', function(){
    document.getElementById('wishes').scrollIntoView({ behavior: 'smooth' });
  });

  /* ---------------------------------------------------------------
     Candles — click to blow out, reveal wish when all are out
  --------------------------------------------------------------- */
  var candleEls = Array.prototype.slice.call(document.querySelectorAll('.candle'));
  var lit = candleEls.length;
  var cakeRect;

  candleEls.forEach(function(c){
    c.addEventListener('click', function(){
      if (!c.classList.contains('lit')) return;
      c.classList.remove('lit');
      c.classList.add('out');
      var smoke = document.createElement('span');
      smoke.className = 'smoke';
      c.appendChild(smoke);
      setTimeout(function(){ smoke.remove(); }, 1200);
      playChime(392 + Math.random() * 60);
      lit--;
      if (lit === 0){
        document.getElementById('cakeHint').style.opacity = '0';
        var reveal = document.getElementById('wishRevealed');
        reveal.classList.add('show');
        cakeRect = document.querySelector('.cake').getBoundingClientRect();
        burstConfetti(cakeRect.left + cakeRect.width / 2, cakeRect.top + cakeRect.height / 2, 160);
        playChime(660);
      }
    });
  });

  /* ---------------------------------------------------------------
     Wish cards — mouse tilt
  --------------------------------------------------------------- */
  if (!reduceMotion){
    document.querySelectorAll('.wish-card').forEach(function(card){
      var baseRotate = card.style.transform;
      card.addEventListener('mousemove', function(e){
        var r = card.getBoundingClientRect();
        var px = (e.clientX - r.left) / r.width;
        var py = (e.clientY - r.top) / r.height;
        var rx = (py - 0.5) * -10;
        var ry = (px - 0.5) * 10;
        card.style.transform = 'perspective(900px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg) translateY(-6px)';
      });
      card.addEventListener('mouseleave', function(){
        card.style.transform = '';
      });
    });
  }

  /* ---------------------------------------------------------------
     Flip cards
  --------------------------------------------------------------- */
  document.querySelectorAll('[data-flip]').forEach(function(card){
    card.querySelector('button').addEventListener('click', function(){
      card.classList.toggle('flipped');
    });
  });

  /* ---------------------------------------------------------------
     Photo lightbox
  --------------------------------------------------------------- */
  var lightbox = document.getElementById('lightbox');
  var lightboxImg = document.getElementById('lightboxImg');
  var lightboxCaption = document.getElementById('lightboxCaption');

  document.querySelectorAll('.polaroid').forEach(function(fig){
    fig.addEventListener('click', function(){
      var img = fig.querySelector('img');
      lightboxImg.src = img.src.replace('/400/400', '/900/900');
      lightboxImg.alt = img.alt;
      lightboxCaption.textContent = fig.dataset.caption || '';
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
  });

  function closeLightbox(){
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
  }
  document.querySelectorAll('[data-close]').forEach(function(el){
    el.addEventListener('click', closeLightbox);
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') closeLightbox();
  });

  /* ---------------------------------------------------------------
     Gift boxes
  --------------------------------------------------------------- */
  document.querySelectorAll('.gift').forEach(function(box){
    box.addEventListener('click', function(){
      if (box.classList.contains('opened')) return;
      box.classList.add('opened');
      var msgEl = box.querySelector('.gift-msg');
      msgEl.textContent = msgEl.dataset.msg;
      var r = box.getBoundingClientRect();
      burstConfetti(r.left + r.width / 2, r.top + r.height / 2, 55);
      playChime(587);
    });
  });

  /* ---------------------------------------------------------------
     Scroll reveal
  --------------------------------------------------------------- */
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting){
          entry.target.classList.add('in-view');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('in-view'); });
  }

  /* ---------------------------------------------------------------
     Finale button — confetti storm + floating hearts + toast
  --------------------------------------------------------------- */
  function showToast(text){
    var toast = document.getElementById('toast');
    toast.textContent = text;
    toast.classList.add('show');
    setTimeout(function(){ toast.classList.remove('show'); }, 2600);
  }

  function spawnHearts(){
    var count = reduceMotion ? 0 : 14;
    for (var i = 0; i < count; i++){
      var heart = document.createElement('div');
      heart.className = 'floating-heart';
      heart.textContent = ['💛','🎈','✨'][i % 3];
      heart.style.left = (Math.random() * 96) + 'vw';
      heart.style.animationDuration = (4 + Math.random() * 3) + 's';
      document.body.appendChild(heart);
      (function(el){ setTimeout(function(){ el.remove(); }, 7500); })(heart);
    }
  }

  document.getElementById('finaleBtn').addEventListener('click', function(){
    burstConfetti(window.innerWidth * 0.5, window.innerHeight * 0.35, 160);
    burstConfetti(window.innerWidth * 0.18, window.innerHeight * 0.5, 90);
    burstConfetti(window.innerWidth * 0.82, window.innerHeight * 0.5, 90);
    spawnHearts();
    playChime(523);
    showToast('🎉 Happy birthday, Alex — go have the best day.');
  });

})();
</script>
